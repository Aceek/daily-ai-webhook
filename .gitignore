# Environment variables (never commit secrets)
.env

# Data interchange directory (temporary files for Claude)
data/

# MCP configuration (contains tokens at runtime, copied at container start)
.mcp.json
# But allow the template in .claude/
!claude-service/.claude/.mcp.json

# n8n data directory (persist locally, not in repo)
n8n-data/*
!n8n-data/.gitkeep

# Execution logs (persist locally, not in repo)
logs/*
!logs/.gitkeep
!logs/workflows/
logs/workflows/*
!logs/workflows/.gitkeep
!logs/research/
logs/research/*
!logs/research/.gitkeep

# n8n credentials exports
*.credentials.json

# Node.js
node_modules/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/

# macOS
.DS_Store

# IDE
.idea/
*.swp
*.swo

# Claude runtime data (generated by Claude CLI)
.claude/usage-stats.json
.claude/debug/
.claude/projects/
.claude/statsig/
.claude/todos/
claude-service/.claude/usage-stats.json
claude-service/.claude/debug/
claude-service/.claude/projects/
claude-service/.claude/statsig/
claude-service/.claude/todos/
claude-service/.claude/shell-snapshots/
